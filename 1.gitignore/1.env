veterinary/                  # Root directory of the project
│
├── app/                      # Main application folder
│   ├── __init__.py           # Initialization of your app
│   ├── routes.py             # Contains your routes (app logic)
│   └── models.py             # Contains your database models
│
├── config/                   # Configuration files
│   └── config.py             # App configuration (e.g., database, mail server)
│
├── templates/                # All your HTML files go here
│   ├── buhera_submissions.html
│   ├── chimanimani_submissions.html
